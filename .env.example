# Required, server-only
OPENAI_API_KEY=

# Recommended current balance of quality and cost (Librarian + RPB)
OPENAI_MODEL=gpt-5.6-terra

# Topic Engine only (propose-topic-directions + propose-topic-opportunities)
TOPIC_ENGINE_MODEL=gpt-5.6-sol

# none | low | medium | high | xhigh | max
OPENAI_REASONING_EFFORT=medium

# Application
NEXT_PUBLIC_APP_NAME=Research Prompt Builder

# Upload limits
MAX_CSV_BYTES=5242880
MAX_CSV_ROWS=2500
MAX_CSV_COLUMNS=100
MAX_SUPPORTING_FILE_BYTES=10485760
MAX_SUPPORTING_FILES_PER_QUESTION=3

# OpenAI client
OPENAI_TIMEOUT_MS=120000
OPENAI_MAX_RETRIES=2
